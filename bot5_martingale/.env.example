# ============================================================
# Bot5 Martingale – Configuration
# ============================================================
# Copy this file to .env in the project root and fill in values.

# -- Mode --
BOT5_MODE=paper                          # "paper" or "live"
BOT5_MARTINGALE_MODE=single              # "single" or "double"

# -- Wallet / Exchange (required for live) --
PRIVATE_KEY=
WALLET_ADDRESS=
CHAIN_ID=137
BOT5_CLOB_HOST=https://clob.polymarket.com

# -- Strategy --
BOT5_LAG=2
BOT5_LOCK_AFTER_N_LOSSES=1
BOT5_LOCK_MODE=same                      # "same" or "anti"

# -- Market --
BOT5_MARKET_INTERVAL_SECONDS=900
BOT5_MARKET_URL_PATTERN=btc-updown-15m-{ts}
BOT5_MARKET_SEARCH_SLUG=Will the price of Bitcoin

# -- Progression (comma-separated USD stakes) --
BOT5_LADDER=6,18,42,90,186,378,762,1530
BOT5_MAX_LEVEL=7                         # 0-indexed; 7 = 8 steps

# -- Pricing / Execution --
BOT5_MAX_ENTRY_PRICE=0.51
BOT5_TARGET_PROFIT_PER_WIN=6.0
BOT5_INFERENCE_WINDOW_SECONDS=60
BOT5_INFERENCE_PRICE_THRESHOLD=0.99
BOT5_EARLY_SIGNAL_ENABLED=true
BOT5_EARLY_SIGNAL_WINDOW_SECONDS=30
BOT5_EARLY_SIGNAL_PRICE_THRESHOLD=0.90
BOT5_EARLY_SIGNAL_CONFIRM_SECONDS=3
BOT5_TOPUP_PRICE_THRESHOLD=0.52
BOT5_ORDER_TIMEOUT_SECONDS=15.0
BOT5_ORDER_POLL_INTERVAL=1.0
BOT5_ORDER_MAX_RETRIES=5
BOT5_ORDER_TYPE_ENTRY=GTC

# -- Risk --
BOT5_MAX_STOPOUTS_PER_DAY=3
BOT5_MAX_DAILY_LOSS_USD=5000.0
BOT5_COOLDOWN_AFTER_STOPOUT_SECONDS=0.0

# -- Timing --
BOT5_TICK_INTERVAL=1.0
BOT5_WARMUP_MARKETS=2
BOT5_PRE_PLACE_SECONDS_BEFORE_END=120

# -- Paper sim --
BOT5_PAPER_FILL_PROB=0.95
BOT5_PAPER_FILL_LATENCY_MS=200.0
BOT5_PAPER_PARTIAL_FILL_MIN_PCT=0.80

# -- Logging --
BOT5_LOG_DIR=logs/bot5_martingale
BOT5_LOG_LEVEL=INFO

# -- Telegram --
BOT5_TELEGRAM_ENABLED=false
BOT5_TELEGRAM_BOT_TOKEN=
BOT5_TELEGRAM_CHAT_ID=
BOT5_TELEGRAM_COMMANDS_ENABLED=false

# -- State --
BOT5_STATE_FILE=bot5_martingale/state.json
BOT5_STATE_RESET_ON_STOP=false             # true => clean state at graceful stop

# -- WebSocket --
BOT5_WS_ENABLED=true
BOT5_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
BOT5_WS_STALE_SECONDS=3.0
